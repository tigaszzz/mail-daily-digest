# Copia para .env (não commitar). Usado no arranque da app para pré-configurar OAuth Google.

# Cliente OAuth tipo «Aplicação para computador» na Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App Azure (só developer) — Outlook pessoal; ver docs/MICROSOFT-OAUTH.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Chaves IA (opcional — também podes guardar nas Definições da app)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
